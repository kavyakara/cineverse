<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎭 Select Theatre"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PVR Orion Mall"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:layout_marginTop="25dp"/>

        <Button
            android:id="@+id/btnPvr10"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="10:00 AM"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_red"/>

        <Button
            android:id="@+id/btnPvr1"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="1:30 PM"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_red"/>

        <Button
            android:id="@+id/btnPvr6"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="6:30 PM"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_red"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INOX"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:layout_marginTop="30dp"/>

        <Button
            android:id="@+id/btnInox11"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="11:00 AM"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_red"/>

        <Button
            android:id="@+id/btnInox4"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="4:00 PM"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_red"/>

        <Button
            android:id="@+id/btnInox9"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="9:30 PM"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_red"/>

    </LinearLayout>

</ScrollView>